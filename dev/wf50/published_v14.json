{"nodes": [{"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1788759963315", "positionAbsolute": {"x": 80, "y": 320}, "data": {"desc": "", "type": "start", "title": "开始", "variables": [{"allowed_file_upload_methods": ["local_file", "remote_url"], "variable": "knowledge_file", "required": false, "allowed_file_extensions": [".TXT", ".MD", ".MARKDOWN", ".PDF", ".HTML", ".HTM", ".XLSX", ".XLS", ".DOCX", ".DOC", ".CSV", ".EML", ".MSG", ".PPTX", ".PPT", ".XML", ".EPUB", ".JSON"], "hide": false, "allowed_file_types": ["document"], "max_length": null, "label": "医学知识文件", "type": "file-list", "options": [], "description": "上传医学知识文件（txt/md/pdf/docx 等），系统会自动生成问答对并入库", "default": null}], "selected": false}, "position": {"y": 320, "x": 80}, "type": "custom", "height": 108, "selected": false, "width": 242}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 1001, "parentId": "node_iteration", "id": "1788759983275", "positionAbsolute": {"x": 1710.1613555683412, "y": 622.7979524408173}, "data": {"isInIteration": true, "isInLoop": false, "desc": "", "query_attachment_selector": [], "query_variable_selector": ["node_iteration", "item"], "retrieval_mode": "multiple", "title": "知识检索", "type": "knowledge-retrieval", "iteration_id": "node_iteration", "dataset_ids": ["3bf78ddc-434e-485f-bd0c-cc8dde12d60a", "11178388-2535-49ca-94a2-d8fca559a44e"], "multiple_retrieval_config": {"top_k": 3, "reranking_enable": true, "reranking_model": {"model": "BAAI/bge-reranker-v2-m3", "provider": "langgenius/siliconflow/siliconflow"}, "weights": {"keyword_setting": {"keyword_weight": 0}, "weight_type": "customized", "vector_setting": {"embedding_provider_name": "langgenius/siliconflow/siliconflow", "vector_weight": 1, "embedding_model_name": "BAAI/bge-m3"}}, "score_threshold": 0.5, "reranking_mode": "reranking_model"}, "selected": false}, "position": {"y": 70, "x": 140}, "type": "custom", "height": 89, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1791687247358", "positionAbsolute": {"x": 680, "y": 320}, "data": {"logical_operator": "and", "desc": "命中 true = 有附件（对话附件或开始节点「医学知识文件」），进入知识库入库；false = 没有附件，走问答检索", "title": "是否有附件", "cases": [{"case_id": "true", "logical_operator": "and", "conditions": [{"varType": "string", "variable_selector": ["node_code_filesrc", "file_flag"], "comparison_operator": "not empty", "value": "", "id": "c85825a3-07ab-46c5-8f66-545dfb1aaf18"}]}], "type": "if-else", "selected": false}, "position": {"y": 320, "x": 680}, "type": "custom", "height": 183, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1791874141296", "positionAbsolute": {"x": 2061.3555470085553, "y": 552.7979524408173}, "data": {"code": "def main(items) -> dict:\n    \"\"\"按「分段」去掉重复的检索结果，让引用与上下文都不再重复。\n\n    items: 迭代节点 flatten 后的检索结果数组，每项形如\n           {\"content\": ..., \"title\": ..., \"files\": ...,\n            \"metadata\": {\"_source\": \"knowledge\", \"dataset_id\": ...,\n                         \"document_id\": ..., \"segment_id\": ..., \"score\": ...}}\n    返回:  {\"result\": [去重后的检索结果]}\n    \"\"\"\n    if items is None:\n        items = []\n    if isinstance(items, dict):\n        items = [items]\n    if not isinstance(items, list):\n        return {\"result\": []}\n\n    kept = []      # 保序保留的结果\n    slot = {}      # 去重键 -> kept 下标\n    texts = set()  # 已保留的正文指纹（正文完全一样也视为重复）\n\n    for it in items:\n        if not isinstance(it, dict):\n            continue\n        content = it.get(\"content\")\n        if not isinstance(content, str):\n            continue\n        content = content.strip()\n        if not content:\n            continue\n\n        meta = it.get(\"metadata\")\n        if not isinstance(meta, dict):\n            meta = {}\n\n        text_key = \" \".join(content.split())\n        ds = str(meta.get(\"dataset_id\") or \"\")\n        seg = str(meta.get(\"segment_id\") or \"\")\n        doc = str(meta.get(\"document_id\") or \"\")\n\n        if seg:\n            key = \"seg|%s|%s\" % (ds, seg)\n        elif doc:\n            key = \"doc|%s|%s|%s\" % (ds, doc, text_key[:200])\n        else:\n            key = \"txt|%s\" % text_key[:200]\n\n        try:\n            score = float(meta.get(\"score\") or 0)\n        except Exception:\n            score = 0.0\n\n        pos = slot.get(key)\n        if pos is not None:\n            # 同一条被多次召回 -> 只留分最高的那份\n            old = kept[pos]\n            old_meta = old.get(\"metadata\")\n            try:\n                old_score = float((old_meta or {}).get(\"score\") or 0)\n            except Exception:\n                old_score = 0.0\n            if score > old_score:\n                kept[pos] = it\n            continue\n\n        if text_key in texts:\n            continue\n\n        texts.add(text_key)\n        slot[key] = len(kept)\n        kept.append(it)\n\n    return {\"result\": kept}\n", "code_language": "python3", "title": "去重", "outputs": {"result": {"type": "array[object]", "children": null}}, "type": "code", "variables": [{"variable": "items", "value_selector": ["node_iteration", "output"]}], "selected": false, "desc": "按分段去掉重复的检索结果，只保留分数最高的一份"}, "position": {"y": 552.7979524408173, "x": 2061.3555470085553}, "type": "custom", "height": 51, "selected": true, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "answer", "positionAbsolute": {"x": 2691.4478672963323, "y": 552.7979524408173}, "data": {"answer": "{{#node_llm_final.text#}}", "desc": "", "title": "直接回复", "type": "answer", "variables": [], "selected": false}, "position": {"y": 552.7979524408173, "x": 2691.4478672963323}, "type": "custom", "height": 101, "selected": true, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_answer_badfile", "positionAbsolute": {"x": 1914.6523385677497, "y": -2.888738631385298}, "data": {"answer": "⚠️ 这份文件没有可用于生成问答对的正文，已跳过入库。\n\n- 原因：{{#node_code_check_text.reason#}}\n- 已提取到的正文字符数：{{#node_code_check_text.doc_chars#}}\n\n常见原因：\n- 文件是扫描件、图片型 PDF，没有文字层；\n- DOCX 内部结构损坏（例如内嵌图片 CRC 校验失败）；\n- 文档本身就是空的。", "desc": "有附件但没提取到正文（无附件已走问答分支，不会到这里）", "title": "提示-文件无正文", "type": "answer", "variables": [], "selected": false}, "position": {"y": -2.888738631385298, "x": 1914.6523385677497}, "type": "custom", "height": 275, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_answer_file", "positionAbsolute": {"x": 3371.3845901022705, "y": 310.1098184739748}, "data": {"answer": "已处理文件《{{#node_code_filesrc.filename#}}》\n\n- 知识库：**{{#node_code_filesrc.filename#}}**（{{#node_code_decide_id.how#}}）\n- 知识库 ID：`{{#node_code_decide_id.dataset_id#}}`\n- 生成的问答对：\n```\n{{#node_llm_gen_qa.text#}}\n```", "desc": "", "title": "文件分支-回复", "type": "answer", "variables": [], "selected": false}, "position": {"y": 310.1098184739748, "x": 3371.3845901022705}, "type": "custom", "height": 206, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_check_text", "positionAbsolute": {"x": 1280, "y": 230}, "data": {"code": "def _flatten(x):\n    if x is None:\n        return \"\"\n    if isinstance(x, str):\n        return x\n    if isinstance(x, (list, tuple)):\n        return \"\\n\".join(_flatten(i) for i in x)\n    if isinstance(x, dict):\n        return str(x.get(\"text\") or x.get(\"content\") or \"\")\n    return str(x)\n\n\ndef main(doc_text, var_text) -> dict:\n    # 两个提取器并行跑，只有一个会拿到文件，取最长的那份当正文\n    parts = [_flatten(doc_text), _flatten(var_text)]\n    body = max(parts, key=lambda s: len(s.strip())).strip()\n    n = len(body)\n    ok = n >= 10  # 少于 10 个字符基本就是空的 / 提取失败\n    if ok:\n        reason = \"提取正常\"\n    else:\n        reason = (\"文件已收到但没提取到正文（可能原因：扫描件/图片型 PDF 无文字层；\"\n                  \"DOCX 结构损坏导致解析失败；文档本身为空）\")\n    return {\n        \"ok\": ok,\n        \"reason\": reason,\n        \"doc_chars\": n,\n        \"text\": body,\n        # 给 if-else 用的一元判断信号（空 = 正常，非空 = 有问题）\n        \"verdict\": \"\" if ok else \"bad\",\n    }\n", "code_language": "python3", "dependencies": [], "desc": "取两份提取结果里最长的一份当正文，并判断是否有效", "title": "校验正文", "outputs": {"ok": {"type": "boolean", "children": null}, "reason": {"type": "string", "children": null}, "text": {"type": "string", "children": null}, "doc_chars": {"type": "number", "children": null}, "verdict": {"type": "string", "children": null}}, "type": "code", "variables": [{"variable": "doc_text", "value_selector": ["node_ext_sys", "text"], "value_type": "array[string]"}, {"variable": "var_text", "value_selector": ["node_ext_var", "text"], "value_type": "array[string]"}], "selected": false}, "position": {"y": 230, "x": 1280}, "type": "custom", "height": 95, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_decide_id", "positionAbsolute": {"x": 2803.197048522162, "y": 310.1098184739748}, "data": {"code": "import json\n\n\ndef _pick_json_lines(text: str) -> list:\n    \"\"\"把模型输出规整成「一行一个 JSON 对象」：\n    1) 统一换行、去掉 markdown 代码围栏\n    2) 用 raw_decode 逐个抽出 JSON 对象并重新序列化（容忍被折行/美化过的输出）\n    3) 一个对象都抽不到时，退回「按行保留非空行」\n    \"\"\"\n    s = (text or \"\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n    s = \"\\n\".join(ln for ln in s.split(\"\\n\") if not ln.strip().startswith(\"```\"))\n\n    objs, dec, i, n = [], json.JSONDecoder(), 0, len(s)\n    while i < n:\n        j = s.find(\"{\", i)\n        if j < 0:\n            break\n        try:\n            obj, end = dec.raw_decode(s, j)\n        except Exception:\n            i = j + 1\n            continue\n        if isinstance(obj, dict):\n            objs.append(json.dumps(obj, ensure_ascii=False))\n        i = end\n    if objs:\n        return objs\n    return [ln.strip() for ln in s.split(\"\\n\") if ln.strip()]\n\n\ndef _find_in_list(list_body: str, name: str) -> str:\n    \"\"\"在「查知识库列表」的返回体里按名称精确匹配，命中则返回 dataset id。\"\"\"\n    try:\n        data = json.loads(list_body or \"{}\")\n    except Exception:\n        return \"\"\n    items = data.get(\"data\") if isinstance(data, dict) else None\n    if not isinstance(items, list):\n        return \"\"\n    for it in items:\n        if isinstance(it, dict) and str(it.get(\"name\") or \"\").strip() == name:\n            return str(it.get(\"id\") or \"\")\n    return \"\"\n\n\ndef main(list_body: str, create_body: str, filename: str, text: str) -> dict:\n    name = (filename or \"\").strip()\n    did = _find_in_list(list_body, name)      # 已存在 -> 复用（新建那步会拿到 409，落默认值）\n    how = \"复用已存在的知识库\"\n    if not did:                               # 不存在 -> 用「新建知识库」返回的 id\n        try:\n            data = json.loads(create_body or \"{}\")\n        except Exception:\n            data = {}\n        if isinstance(data, dict):\n            did = str(data.get(\"id\") or \"\")\n        how = \"新建知识库\" if did else \"未取到知识库ID（请看节点运行日志）\"\n    lines = _pick_json_lines(text)            # 每行一个 JSON 语句 -> 一行 = 一个分段\n    return {\n        \"dataset_id\": did,\n        \"how\": how,\n        \"text_esc\": json.dumps(\"\\n\".join(lines), ensure_ascii=False)[1:-1],\n        \"segments_expected\": len(lines),\n    }\n", "code_language": "python3", "dependencies": [], "desc": "先在知识库列表里按文件名命中（复用），否则用新建返回的 id；顺便转义正文", "title": "确定知识库ID", "outputs": {"dataset_id": {"type": "string", "children": null}, "how": {"type": "string", "children": null}, "text_esc": {"type": "string", "children": null}, "segments_expected": {"type": "number", "children": null}}, "type": "code", "variables": [{"variable": "list_body", "value_selector": ["node_http_list_kb", "body"], "value_type": "string"}, {"variable": "create_body", "value_selector": ["node_http_create_kb", "body"], "value_type": "string"}, {"variable": "filename", "value_selector": ["node_code_filesrc", "filename"], "value_type": "string"}, {"variable": "text", "value_selector": ["node_llm_gen_qa", "text"], "value_type": "string"}], "selected": false}, "position": {"y": 310.1098184739748, "x": 2803.197048522162}, "type": "custom", "height": 111, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_filesrc", "positionAbsolute": {"x": 380, "y": 320}, "data": {"code": "import json\n\n\ndef _name_of(f):\n    if f is None:\n        return None\n    if isinstance(f, str):\n        return f or None\n    if isinstance(f, dict):\n        return f.get(\"name\") or f.get(\"filename\") or None\n    return getattr(f, \"name\", None) or getattr(f, \"filename\", None)\n\n\ndef _as_list(x):\n    if x is None:\n        return []\n    if isinstance(x, list):\n        return x\n    return [x]\n\n\ndef main(files, file_var) -> dict:\n    # 对话附件优先；没有对话附件就用开始节点的「医学知识文件」。不区分来源，\n    # 只要任一路有文件就算「有附件」，直接进入知识库入库分支。\n    all_files = _as_list(files) + _as_list(file_var)\n    name = _name_of(all_files[0]) if all_files else None\n    name = str(name) if name else \"医学知识文件\"\n    return {\n        \"filename\": name,\n        \"filename_esc\": json.dumps(name, ensure_ascii=False)[1:-1],\n        # 故意用「非空字符串」而不是布尔：Dify 编辑器的 if-else 会把布尔条件值\n        # 改写成字符串（false -> \"true\"），而 `not empty` 是一元判断、没有期望值，\n        # 不会被编辑器改坏。\n        \"file_flag\": \"1\" if all_files else \"\",\n    }\n", "code_language": "python3", "dependencies": [], "desc": "取文件名（给知识库命名）；file_flag 非空 = 对话附件或开始节点文件变量里有文件", "title": "读取文件信息", "outputs": {"filename_esc": {"type": "string", "children": null}, "file_flag": {"type": "string", "children": null}, "filename": {"type": "string", "children": null}}, "type": "code", "variables": [{"value_selector": ["sys", "files"], "value_type": "array[file]", "variable": "files"}, {"value_selector": ["1788759963315", "knowledge_file"], "value_type": "array[file]", "variable": "file_var"}], "selected": false}, "position": {"y": 320, "x": 380}, "type": "custom", "height": 111, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_parse_q", "positionAbsolute": {"x": 1300.1655767887353, "y": 560.1755125167521}, "data": {"code": "import json, re\ndef main(text: str) -> dict:\n    s = (text or \"\").strip()\n    m = re.search(r\"\\[.*\\]\", s, re.S)\n    if m:\n        s = m.group(0)\n    try:\n        arr = json.loads(s)\n    except Exception:\n        arr = []\n    if not isinstance(arr, list):\n        arr = []\n    qs = []\n    for x in arr:\n        if isinstance(x, str) and x.strip():\n            qs.append(x.strip())\n        elif isinstance(x, dict):\n            q = x.get(\"question\") or x.get(\"q\")\n            if q:\n                qs.append(str(q).strip())\n    seen, out = set(), []\n    for q in qs:\n        if q not in seen:\n            seen.add(q)\n            out.append(q)\n    if not out:\n        out = [s] if s else [\"医学问题\"]\n    return {\"questions\": out}\n", "code_language": "python3", "dependencies": [], "desc": "", "title": "解析相似问", "outputs": {"questions": {"type": "array[string]", "children": null}}, "type": "code", "variables": [{"value_selector": ["node_llm_similar", "text"], "value_type": "string", "variable": "text"}], "selected": false}, "position": {"y": 560.1755125167521, "x": 1300.1655767887353}, "type": "custom", "height": 51, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_ext_sys", "positionAbsolute": {"x": 1000, "y": 100.53313777368889}, "data": {"desc": "读取对话框附件里的纯文本", "retry_config": {"max_retries": 0, "retry_interval": 0, "retry_enabled": false}, "title": "文档提取器(对话附件)", "error_strategy": "default-value", "type": "document-extractor", "variable_selector": ["sys", "files"], "default_value": [{"value": "", "type": "string", "key": "text"}], "selected": false}, "position": {"y": 100.53313777368889, "x": 1000}, "type": "custom", "height": 131, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex