{"nodes": [{"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1788759963315", "positionAbsolute": {"x": 80, "y": 320}, "data": {"desc": "", "type": "start", "title": "\u5f00\u59cb", "variables": [{"allowed_file_upload_methods": ["local_file", "remote_url"], "variable": "knowledge_file", "required": false, "allowed_file_extensions": [".TXT", ".MD", ".MARKDOWN", ".PDF", ".HTML", ".HTM", ".XLSX", ".XLS", ".DOCX", ".DOC", ".CSV", ".EML", ".MSG", ".PPTX", ".PPT", ".XML", ".EPUB", ".JSON"], "hide": false, "allowed_file_types": ["document"], "max_length": null, "label": "\u533b\u5b66\u77e5\u8bc6\u6587\u4ef6", "type": "file-list", "options": [], "description": "\u4e0a\u4f20\u533b\u5b66\u77e5\u8bc6\u6587\u4ef6\uff08txt/md/pdf/docx \u7b49\uff09\uff0c\u7cfb\u7edf\u4f1a\u81ea\u52a8\u751f\u6210\u95ee\u7b54\u5bf9\u5e76\u5165\u5e93", "default": null}], "selected": false}, "position": {"y": 320, "x": 80}, "type": "custom", "height": 108, "selected": false, "width": 242}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 1001, "parentId": "node_iteration", "id": "1788759983275", "positionAbsolute": {"x": 1710.1613555683412, "y": 622.7979524408173}, "data": {"isInIteration": true, "isInLoop": false, "desc": "", "query_attachment_selector": [], "query_variable_selector": ["node_iteration", "item"], "retrieval_mode": "multiple", "title": "\u77e5\u8bc6\u68c0\u7d22", "type": "knowledge-retrieval", "iteration_id": "node_iteration", "dataset_ids": ["3bf78ddc-434e-485f-bd0c-cc8dde12d60a", "11178388-2535-49ca-94a2-d8fca559a44e"], "multiple_retrieval_config": {"top_k": 3, "reranking_enable": true, "reranking_model": {"model": "BAAI/bge-reranker-v2-m3", "provider": "langgenius/siliconflow/siliconflow"}, "weights": {"keyword_setting": {"keyword_weight": 0}, "weight_type": "customized", "vector_setting": {"embedding_provider_name": "langgenius/siliconflow/siliconflow", "vector_weight": 1, "embedding_model_name": "BAAI/bge-m3"}}, "score_threshold": 0.5, "reranking_mode": "reranking_model"}, "selected": false}, "position": {"y": 70, "x": 140}, "type": "custom", "height": 89, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1791687247358", "positionAbsolute": {"x": 680, "y": 320}, "data": {"logical_operator": "and", "desc": "\u547d\u4e2d true = \u6709\u9644\u4ef6\uff08\u5bf9\u8bdd\u9644\u4ef6\u6216\u5f00\u59cb\u8282\u70b9\u300c\u533b\u5b66\u77e5\u8bc6\u6587\u4ef6\u300d\uff09\uff0c\u8fdb\u5165\u77e5\u8bc6\u5e93\u5165\u5e93\uff1bfalse = \u6ca1\u6709\u9644\u4ef6\uff0c\u8d70\u95ee\u7b54\u68c0\u7d22", "title": "\u662f\u5426\u6709\u9644\u4ef6", "cases": [{"case_id": "true", "logical_operator": "and", "conditions": [{"varType": "string", "variable_selector": ["node_code_filesrc", "file_flag"], "comparison_operator": "not empty", "value": "", "id": "c85825a3-07ab-46c5-8f66-545dfb1aaf18"}]}], "type": "if-else", "selected": false}, "position": {"y": 320, "x": 680}, "type": "custom", "height": 183, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "1791874141296", "positionAbsolute": {"x": 2061.3555470085553, "y": 552.7979524408173}, "data": {"code": "\ndef main(arg1: str, arg2: str):\n    return {\n        \"result\": arg1 + arg2,\n    }\n", "code_language": "python3", "title": "\u53bb\u91cd", "outputs": {"result": {"type": "string", "children": null}}, "type": "code", "variables": [{"variable": "arg1", "value_selector": []}, {"variable": "arg2", "value_selector": []}], "selected": false}, "position": {"y": 552.7979524408173, "x": 2061.3555470085553}, "type": "custom", "height": 51, "selected": true, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "answer", "positionAbsolute": {"x": 2691.4478672963323, "y": 552.7979524408173}, "data": {"answer": "{{#node_llm_final.text#}}", "desc": "", "title": "\u76f4\u63a5\u56de\u590d", "type": "answer", "variables": [], "selected": false}, "position": {"y": 552.7979524408173, "x": 2691.4478672963323}, "type": "custom", "height": 101, "selected": true, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_answer_badfile", "positionAbsolute": {"x": 1914.6523385677497, "y": -2.888738631385298}, "data": {"answer": "\u26a0\ufe0f \u8fd9\u4efd\u6587\u4ef6\u6ca1\u6709\u53ef\u7528\u4e8e\u751f\u6210\u95ee\u7b54\u5bf9\u7684\u6b63\u6587\uff0c\u5df2\u8df3\u8fc7\u5165\u5e93\u3002\n\n- \u539f\u56e0\uff1a{{#node_code_check_text.reason#}}\n- \u5df2\u63d0\u53d6\u5230\u7684\u6b63\u6587\u5b57\u7b26\u6570\uff1a{{#node_code_check_text.doc_chars#}}\n\n\u5e38\u89c1\u539f\u56e0\uff1a\n- \u6587\u4ef6\u662f\u626b\u63cf\u4ef6\u3001\u56fe\u7247\u578b PDF\uff0c\u6ca1\u6709\u6587\u5b57\u5c42\uff1b\n- DOCX \u5185\u90e8\u7ed3\u6784\u635f\u574f\uff08\u4f8b\u5982\u5185\u5d4c\u56fe\u7247 CRC \u6821\u9a8c\u5931\u8d25\uff09\uff1b\n- \u6587\u6863\u672c\u8eab\u5c31\u662f\u7a7a\u7684\u3002", "desc": "\u6709\u9644\u4ef6\u4f46\u6ca1\u63d0\u53d6\u5230\u6b63\u6587\uff08\u65e0\u9644\u4ef6\u5df2\u8d70\u95ee\u7b54\u5206\u652f\uff0c\u4e0d\u4f1a\u5230\u8fd9\u91cc\uff09", "title": "\u63d0\u793a-\u6587\u4ef6\u65e0\u6b63\u6587", "type": "answer", "variables": [], "selected": false}, "position": {"y": -2.888738631385298, "x": 1914.6523385677497}, "type": "custom", "height": 275, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_answer_file", "positionAbsolute": {"x": 3371.3845901022705, "y": 310.1098184739748}, "data": {"answer": "\u5df2\u5904\u7406\u6587\u4ef6\u300a{{#node_code_filesrc.filename#}}\u300b\n\n- \u77e5\u8bc6\u5e93\uff1a**{{#node_code_filesrc.filename#}}**\uff08{{#node_code_decide_id.how#}}\uff09\n- \u77e5\u8bc6\u5e93 ID\uff1a`{{#node_code_decide_id.dataset_id#}}`\n- \u751f\u6210\u7684\u95ee\u7b54\u5bf9\uff1a\n```\n{{#node_llm_gen_qa.text#}}\n```", "desc": "", "title": "\u6587\u4ef6\u5206\u652f-\u56de\u590d", "type": "answer", "variables": [], "selected": false}, "position": {"y": 310.1098184739748, "x": 3371.3845901022705}, "type": "custom", "height": 206, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_check_text", "positionAbsolute": {"x": 1280, "y": 230}, "data": {"code": "def _flatten(x):\n    if x is None:\n        return \"\"\n    if isinstance(x, str):\n        return x\n    if isinstance(x, (list, tuple)):\n        return \"\\n\".join(_flatten(i) for i in x)\n    if isinstance(x, dict):\n        return str(x.get(\"text\") or x.get(\"content\") or \"\")\n    return str(x)\n\n\ndef main(doc_text, var_text) -> dict:\n    # \u4e24\u4e2a\u63d0\u53d6\u5668\u5e76\u884c\u8dd1\uff0c\u53ea\u6709\u4e00\u4e2a\u4f1a\u62ff\u5230\u6587\u4ef6\uff0c\u53d6\u6700\u957f\u7684\u90a3\u4efd\u5f53\u6b63\u6587\n    parts = [_flatten(doc_text), _flatten(var_text)]\n    body = max(parts, key=lambda s: len(s.strip())).strip()\n    n = len(body)\n    ok = n >= 10  # \u5c11\u4e8e 10 \u4e2a\u5b57\u7b26\u57fa\u672c\u5c31\u662f\u7a7a\u7684 / \u63d0\u53d6\u5931\u8d25\n    if ok:\n        reason = \"\u63d0\u53d6\u6b63\u5e38\"\n    else:\n        reason = (\"\u6587\u4ef6\u5df2\u6536\u5230\u4f46\u6ca1\u63d0\u53d6\u5230\u6b63\u6587\uff08\u53ef\u80fd\u539f\u56e0\uff1a\u626b\u63cf\u4ef6/\u56fe\u7247\u578b PDF \u65e0\u6587\u5b57\u5c42\uff1b\"\n                  \"DOCX \u7ed3\u6784\u635f\u574f\u5bfc\u81f4\u89e3\u6790\u5931\u8d25\uff1b\u6587\u6863\u672c\u8eab\u4e3a\u7a7a\uff09\")\n    return {\n        \"ok\": ok,\n        \"reason\": reason,\n        \"doc_chars\": n,\n        \"text\": body,\n        # \u7ed9 if-else \u7528\u7684\u4e00\u5143\u5224\u65ad\u4fe1\u53f7\uff08\u7a7a = \u6b63\u5e38\uff0c\u975e\u7a7a = \u6709\u95ee\u9898\uff09\n        \"verdict\": \"\" if ok else \"bad\",\n    }\n", "code_language": "python3", "dependencies": [], "desc": "\u53d6\u4e24\u4efd\u63d0\u53d6\u7ed3\u679c\u91cc\u6700\u957f\u7684\u4e00\u4efd\u5f53\u6b63\u6587\uff0c\u5e76\u5224\u65ad\u662f\u5426\u6709\u6548", "title": "\u6821\u9a8c\u6b63\u6587", "outputs": {"ok": {"type": "boolean", "children": null}, "reason": {"type": "string", "children": null}, "text": {"type": "string", "children": null}, "doc_chars": {"type": "number", "children": null}, "verdict": {"type": "string", "children": null}}, "type": "code", "variables": [{"variable": "doc_text", "value_selector": ["node_ext_sys", "text"], "value_type": "array[string]"}, {"variable": "var_text", "value_selector": ["node_ext_var", "text"], "value_type": "array[string]"}], "selected": false}, "position": {"y": 230, "x": 1280}, "type": "custom", "height": 95, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_decide_id", "positionAbsolute": {"x": 2803.197048522162, "y": 310.1098184739748}, "data": {"code": "import json\n\n\ndef _pick_json_lines(text: str) -> list:\n    \"\"\"\u628a\u6a21\u578b\u8f93\u51fa\u89c4\u6574\u6210\u300c\u4e00\u884c\u4e00\u4e2a JSON \u5bf9\u8c61\u300d\uff1a\n    1) \u7edf\u4e00\u6362\u884c\u3001\u53bb\u6389 markdown \u4ee3\u7801\u56f4\u680f\n    2) \u7528 raw_decode \u9010\u4e2a\u62bd\u51fa JSON \u5bf9\u8c61\u5e76\u91cd\u65b0\u5e8f\u5217\u5316\uff08\u5bb9\u5fcd\u88ab\u6298\u884c/\u7f8e\u5316\u8fc7\u7684\u8f93\u51fa\uff09\n    3) \u4e00\u4e2a\u5bf9\u8c61\u90fd\u62bd\u4e0d\u5230\u65f6\uff0c\u9000\u56de\u300c\u6309\u884c\u4fdd\u7559\u975e\u7a7a\u884c\u300d\n    \"\"\"\n    s = (text or \"\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n    s = \"\\n\".join(ln for ln in s.split(\"\\n\") if not ln.strip().startswith(\"```\"))\n\n    objs, dec, i, n = [], json.JSONDecoder(), 0, len(s)\n    while i < n:\n        j = s.find(\"{\", i)\n        if j < 0:\n            break\n        try:\n            obj, end = dec.raw_decode(s, j)\n        except Exception:\n            i = j + 1\n            continue\n        if isinstance(obj, dict):\n            objs.append(json.dumps(obj, ensure_ascii=False))\n        i = end\n    if objs:\n        return objs\n    return [ln.strip() for ln in s.split(\"\\n\") if ln.strip()]\n\n\ndef _find_in_list(list_body: str, name: str) -> str:\n    \"\"\"\u5728\u300c\u67e5\u77e5\u8bc6\u5e93\u5217\u8868\u300d\u7684\u8fd4\u56de\u4f53\u91cc\u6309\u540d\u79f0\u7cbe\u786e\u5339\u914d\uff0c\u547d\u4e2d\u5219\u8fd4\u56de dataset id\u3002\"\"\"\n    try:\n        data = json.loads(list_body or \"{}\")\n    except Exception:\n        return \"\"\n    items = data.get(\"data\") if isinstance(data, dict) else None\n    if not isinstance(items, list):\n        return \"\"\n    for it in items:\n        if isinstance(it, dict) and str(it.get(\"name\") or \"\").strip() == name:\n            return str(it.get(\"id\") or \"\")\n    return \"\"\n\n\ndef main(list_body: str, create_body: str, filename: str, text: str) -> dict:\n    name = (filename or \"\").strip()\n    did = _find_in_list(list_body, name)      # \u5df2\u5b58\u5728 -> \u590d\u7528\uff08\u65b0\u5efa\u90a3\u6b65\u4f1a\u62ff\u5230 409\uff0c\u843d\u9ed8\u8ba4\u503c\uff09\n    how = \"\u590d\u7528\u5df2\u5b58\u5728\u7684\u77e5\u8bc6\u5e93\"\n    if not did:                               # \u4e0d\u5b58\u5728 -> \u7528\u300c\u65b0\u5efa\u77e5\u8bc6\u5e93\u300d\u8fd4\u56de\u7684 id\n        try:\n            data = json.loads(create_body or \"{}\")\n        except Exception:\n            data = {}\n        if isinstance(data, dict):\n            did = str(data.get(\"id\") or \"\")\n        how = \"\u65b0\u5efa\u77e5\u8bc6\u5e93\" if did else \"\u672a\u53d6\u5230\u77e5\u8bc6\u5e93ID\uff08\u8bf7\u770b\u8282\u70b9\u8fd0\u884c\u65e5\u5fd7\uff09\"\n    lines = _pick_json_lines(text)            # \u6bcf\u884c\u4e00\u4e2a JSON \u8bed\u53e5 -> \u4e00\u884c = \u4e00\u4e2a\u5206\u6bb5\n    return {\n        \"dataset_id\": did,\n        \"how\": how,\n        \"text_esc\": json.dumps(\"\\n\".join(lines), ensure_ascii=False)[1:-1],\n        \"segments_expected\": len(lines),\n    }\n", "code_language": "python3", "dependencies": [], "desc": "\u5148\u5728\u77e5\u8bc6\u5e93\u5217\u8868\u91cc\u6309\u6587\u4ef6\u540d\u547d\u4e2d\uff08\u590d\u7528\uff09\uff0c\u5426\u5219\u7528\u65b0\u5efa\u8fd4\u56de\u7684 id\uff1b\u987a\u4fbf\u8f6c\u4e49\u6b63\u6587", "title": "\u786e\u5b9a\u77e5\u8bc6\u5e93ID", "outputs": {"dataset_id": {"type": "string", "children": null}, "how": {"type": "string", "children": null}, "text_esc": {"type": "string", "children": null}, "segments_expected": {"type": "number", "children": null}}, "type": "code", "variables": [{"variable": "list_body", "value_selector": ["node_http_list_kb", "body"], "value_type": "string"}, {"variable": "create_body", "value_selector": ["node_http_create_kb", "body"], "value_type": "string"}, {"variable": "filename", "value_selector": ["node_code_filesrc", "filename"], "value_type": "string"}, {"variable": "text", "value_selector": ["node_llm_gen_qa", "text"], "value_type": "string"}], "selected": false}, "position": {"y": 310.1098184739748, "x": 2803.197048522162}, "type": "custom", "height": 111, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_filesrc", "positionAbsolute": {"x": 380, "y": 320}, "data": {"code": "import json\n\n\ndef _name_of(f):\n    if f is None:\n        return None\n    if isinstance(f, str):\n        return f or None\n    if isinstance(f, dict):\n        return f.get(\"name\") or f.get(\"filename\") or None\n    return getattr(f, \"name\", None) or getattr(f, \"filename\", None)\n\n\ndef _as_list(x):\n    if x is None:\n        return []\n    if isinstance(x, list):\n        return x\n    return [x]\n\n\ndef main(files, file_var) -> dict:\n    # \u5bf9\u8bdd\u9644\u4ef6\u4f18\u5148\uff1b\u6ca1\u6709\u5bf9\u8bdd\u9644\u4ef6\u5c31\u7528\u5f00\u59cb\u8282\u70b9\u7684\u300c\u533b\u5b66\u77e5\u8bc6\u6587\u4ef6\u300d\u3002\u4e0d\u533a\u5206\u6765\u6e90\uff0c\n    # \u53ea\u8981\u4efb\u4e00\u8def\u6709\u6587\u4ef6\u5c31\u7b97\u300c\u6709\u9644\u4ef6\u300d\uff0c\u76f4\u63a5\u8fdb\u5165\u77e5\u8bc6\u5e93\u5165\u5e93\u5206\u652f\u3002\n    all_files = _as_list(files) + _as_list(file_var)\n    name = _name_of(all_files[0]) if all_files else None\n    name = str(name) if name else \"\u533b\u5b66\u77e5\u8bc6\u6587\u4ef6\"\n    return {\n        \"filename\": name,\n        \"filename_esc\": json.dumps(name, ensure_ascii=False)[1:-1],\n        # \u6545\u610f\u7528\u300c\u975e\u7a7a\u5b57\u7b26\u4e32\u300d\u800c\u4e0d\u662f\u5e03\u5c14\uff1aDify \u7f16\u8f91\u5668\u7684 if-else \u4f1a\u628a\u5e03\u5c14\u6761\u4ef6\u503c\n        # \u6539\u5199\u6210\u5b57\u7b26\u4e32\uff08false -> \"true\"\uff09\uff0c\u800c `not empty` \u662f\u4e00\u5143\u5224\u65ad\u3001\u6ca1\u6709\u671f\u671b\u503c\uff0c\n        # \u4e0d\u4f1a\u88ab\u7f16\u8f91\u5668\u6539\u574f\u3002\n        \"file_flag\": \"1\" if all_files else \"\",\n    }\n", "code_language": "python3", "dependencies": [], "desc": "\u53d6\u6587\u4ef6\u540d\uff08\u7ed9\u77e5\u8bc6\u5e93\u547d\u540d\uff09\uff1bfile_flag \u975e\u7a7a = \u5bf9\u8bdd\u9644\u4ef6\u6216\u5f00\u59cb\u8282\u70b9\u6587\u4ef6\u53d8\u91cf\u91cc\u6709\u6587\u4ef6", "title": "\u8bfb\u53d6\u6587\u4ef6\u4fe1\u606f", "outputs": {"filename_esc": {"type": "string", "children": null}, "file_flag": {"type": "string", "children": null}, "filename": {"type": "string", "children": null}}, "type": "code", "variables": [{"value_selector": ["sys", "files"], "value_type": "array[file]", "variable": "files"}, {"value_selector": ["1788759963315", "knowledge_file"], "value_type": "array[file]", "variable": "file_var"}], "selected": false}, "position": {"y": 320, "x": 380}, "type": "custom", "height": 111, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_code_parse_q", "positionAbsolute": {"x": 1300.1655767887353, "y": 560.1755125167521}, "data": {"code": "import json, re\ndef main(text: str) -> dict:\n    s = (text or \"\").strip()\n    m = re.search(r\"\\[.*\\]\", s, re.S)\n    if m:\n        s = m.group(0)\n    try:\n        arr = json.loads(s)\n    except Exception:\n        arr = []\n    if not isinstance(arr, list):\n        arr = []\n    qs = []\n    for x in arr:\n        if isinstance(x, str) and x.strip():\n            qs.append(x.strip())\n        elif isinstance(x, dict):\n            q = x.get(\"question\") or x.get(\"q\")\n            if q:\n                qs.append(str(q).strip())\n    seen, out = set(), []\n    for q in qs:\n        if q not in seen:\n            seen.add(q)\n            out.append(q)\n    if not out:\n        out = [s] if s else [\"\u533b\u5b66\u95ee\u9898\"]\n    return {\"questions\": out}\n", "code_language": "python3", "dependencies": [], "desc": "", "title": "\u89e3\u6790\u76f8\u4f3c\u95ee", "outputs": {"questions": {"type": "array[string]", "children": null}}, "type": "code", "variables": [{"value_selector": ["node_llm_similar", "text"], "value_type": "string", "variable": "text"}], "selected": false}, "position": {"y": 560.1755125167521, "x": 1300.1655767887353}, "type": "custom", "height": 51, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_ext_sys", "positionAbsolute": {"x": 1000, "y": 100.53313777368889}, "data": {"desc": "\u8bfb\u53d6\u5bf9\u8bdd\u6846\u9644\u4ef6\u91cc\u7684\u7eaf\u6587\u672c", "retry_config": {"max_retries": 0, "retry_interval": 0, "retry_enabled": false}, "title": "\u6587\u6863\u63d0\u53d6\u5668(\u5bf9\u8bdd\u9644\u4ef6)", "error_strategy": "default-value", "type": "document-extractor", "variable_selector": ["sys", "files"], "default_value": [{"value": "", "type": "string", "key": "text"}], "selected": false}, "position": {"y": 100.53313777368889, "x": 1000}, "type": "custom", "height": 131, "selected": false, "width": 241}, {"sourcePosition": "right", "targetPosition": "left", "zIndex": 0, "id": "node_ext_var", "positionAbsolute": {"x": 1000, "y": 253.92399131059847}, "data": {"desc": "