"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"1a6f1e0f-6720-4c0d-803b-2b6fa27c09e5","retriever_from":"workflow","score":0.9627590179443359,"child_chunks":[],"segment_hit_count":7,"segment_word_count":322,"segment_position":2,"segment_index_node_hash":"7c0453b23f8a94fb26ed303980a7eda1f486499b1bbf71ffaf8e334bc82208d1","doc_metadata":null,"position":2},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"病原菌通过哪些途径传播？ / 病原菌引起感染与哪些因素密切相关？ / 细菌感染的类型包括哪些？ / 显性感染包括哪些类型？ / 什么是带菌状态？\", \"response_chosen\": \"病原菌通过呼吸道、消化道、皮肤黏膜创伤、接触传播、以节肢动物为媒介、多途径传播。同时，病原菌是否引起感染与细菌的毒力、侵入数量以及侵入的门户密切相关。感染类型还包括显性感染、隐性感染和带菌状态。显性感染包括急性感染、慢性感染、局部感染和全身感染；带菌状态因带菌者体内带有病原菌，但无临床症状，常成为传染病流行的重要传染源。\"}","summary":null}]},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":4.301545,"execution_metadata":{"total_tokens":0,"total_price":"0.0","currency":"USD","iteration_id":"node_iteration","iteration_index":0},"created_at":1791878978,"finished_at":1791878982,"files":[],"iteration_id":"node_iteration","loop_id":null}}

