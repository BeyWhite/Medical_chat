data: {"event":"node_finished","conversation_id":"aaf3c988-84c9-459e-bcb3-dd076c3437c7","message_id":"2eb8fe09-9d43-4c6b-af46-730654b5f646","created_at":1791878972,"task_id":"c2ec2696-ef4c-42d9-a7eb-cdc784d9d03d","workflow_run_id":"beb9b4fd-3c51-44d5-ac73-00da24dd42cd","data":{"id":"bc62ec31-10a3-4fbb-909e-e42c9cec4a9c","node_id":"1791874141296","node_type":"code","title":"去重","index":1,"predecessor_node_id":null,"inputs":{"items":[{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"b3599964-2f8c-4713-a0d9-19f63e5f9b17","retriever_from":"workflow","score":0.9981842637062073,"child_chunks":[],"segment_hit_count":10,"segment_word_count":344,"segment_position":1,"segment_index_node_hash":"8e466fd404cd840871b8bbb34b99016c3da8ace719f256148f4df77d6369195e","doc_metadata":null,"position":1},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"细菌性感染疾病是如何发生的？ / 细菌感染的定义是什么？ / 感染发生的首要条件是什么？ / 什么是细菌的外源性感染？ / 什么是细菌的内源性感染？\", \"response_chosen\": \"细菌的感染是指病原菌侵入宿主体内生长繁殖并与机体相互作用，引起的一系列病理变化过程。感染的发生首先必须有感染源（传染源）。外源性感染：患者是主要传染源，带菌者、患病或带菌动物也会引起感染。内源性感染：机体自身的体表或体内病原菌而引起的感染。这些病原菌大多是寄居在体表或体内的正常菌群，当机体免疫功能下降或其他因素，导致体内正常菌群失调而成为条件致病菌，造成感染。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"1a6f1e0f-6720-4c0d-803b-2b6fa27c09e5","retriever_from":"workflow","score":0.9627590179443359,"child_chunks":[],"segment_hit_count":7,"segment_word_count":322,"segment_position":2,"segment_index_node_hash":"7c0453b23f8a94fb26ed303980a7eda1f486499b1bbf71ffaf8e334bc82208d1","doc_metadata":null,"position":2},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"病原菌通过哪些途径传播？ / 病原菌引起感染与哪些因素密切相关？ / 细菌感染的类型包括哪些？ / 显性感染包括哪些类型？ / 什么是带菌状态？\", \"response_chosen\": \"病原菌通过呼吸道、消化道、皮肤黏膜创伤、接触传播、以节肢动物为媒介、多途径传播。同时，病原菌是否引起感染与细菌的毒力、侵入数量以及侵入的门户密切相关。感染类型还包括显性感染、隐性感染和带菌状态。显性感染包括急性感染、慢性感染、局部感染和全身感染；带菌状态因带菌者体内带有病原菌，但无临床症状，常成为传染病流行的重要传染源。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"b3599964-2f8c-4713-a0d9-19f63e5f9b17","retriever_from":"workflow","score":0.9935769438743591,"child_chunks":[],"segment_hit_count":12,"segment_word_count":344,"segment_position":1,"segment_index_node_hash":"8e466fd404cd840871b8bbb34b99016c3da8ace719f256148f4df77d6369195e","doc_metadata":null,"position":1},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"细菌性感染疾病是如何发生的？ / 细菌感染的定义是什么？ / 感染发生的首要条件是什么？ / 什么是细菌的外源性感染？ / 什么是细菌的内源性感染？\", \"response_chosen\": \"细菌的感染是指病原菌侵入宿主体内生长繁殖并与机体相互作用，引起的一系列病理变化过程。感染的发生首先必须有感染源（传染源）。外源性感染：患者是主要传染源，带菌者、患病或带菌动物也会引起感染。内源性感染：机体自身的体表或体内病原菌而引起的感染。这些病原菌大多是寄居在体表或体内的正常菌群，当机体免疫功能下降或其他因素，导致体内正常菌群失调而成为条件致病菌，造成感染。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"1a6f1e0f-6720-4c0d-803b-2b6fa27c09e5","retriever_from":"workflow","score":0.8848876953125,"child_chunks":[],"segment_hit_count":9,"segment_word_count":322,"segment_position":2,"segment_index_node_hash":"7c0453b23f8a94fb26ed303980a7eda1f486499b1bbf71ffaf8e334bc82208d1","doc_metadata":null,"position":2},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"病原菌通过哪些途径传播？ / 病原菌引起感染与哪些因素密切相关？ / 细菌感染的类型包括哪些？ / 显性感染包括哪些类型？ / 什么是带菌状态？\", \"response_chosen\": \"病原菌通过呼吸道、消化道、皮肤黏膜创伤、接触传播、以节肢动物为媒介、多途径传播。同时，病原菌是否引起感染与细菌的毒力、侵入数量以及侵入的门户密切相关。感染类型还包括显性感染、隐性感染和带菌状态。显性感染包括急性感染、慢性感染、局部感染和全身感染；带菌状态因带菌者体内带有病原菌，但无临床症状，常成为传染病流行的重要传染源。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"27582a0d-d01a-4bb3-a8f4-18cf5bee82c4","retriever_from":"workflow","score":0.7054923176765442,"child_chunks":[],"segment_hit_count":4,"segment_word_count":270,"segment_position":6,"segment_index_node_hash":"ec3ae9719324d56042a67f06bc473cff9bfd7b8d8c3c7eeb036207157570f5ae","doc_metadata":null,"position":3},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第三节_细菌与病毒的致病机制及感染类型比较\", \"question\": \"细菌的致病机制是什么？ / 病原菌造成感染与哪些因素有关？ / 细菌毒力主要由哪些构成？ / 什么是细菌的侵袭力？ / 细菌毒素包括哪些？\", \"response_chosen\": \"病原菌造成感染与毒力、细菌侵入数量、细菌侵入的门户与部位有关。细菌毒力主要由侵袭力、毒素和体内其他因素（超抗原）构成。侵袭力：菌体表面结构（黏附因子菌毛、荚膜），侵袭性物质，细菌生物被膜。毒素：内毒素，外毒素。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"27582a0d-d01a-4bb3-a8f4-18cf5bee82c4","retriever_from":"workflow","score":0.9548537731170654,"child_chunks":[],"segment_hit_count":4,"segment_word_count":270,"segment_position":6,"segment_index_node_hash":"ec3ae9719324d56042a67f06bc473cff9bfd7b8d8c3c7eeb036207157570f5ae","doc_metadata":null,"position":1},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第三节_细菌与病毒的致病机制及感染类型比较\", \"question\": \"细菌的致病机制是什么？ / 病原菌造成感染与哪些因素有关？ / 细菌毒力主要由哪些构成？ / 什么是细菌的侵袭力？ / 细菌毒素包括哪些？\", \"response_chosen\": \"病原菌造成感染与毒力、细菌侵入数量、细菌侵入的门户与部位有关。细菌毒力主要由侵袭力、毒素和体内其他因素（超抗原）构成。侵袭力：菌体表面结构（黏附因子菌毛、荚膜），侵袭性物质，细菌生物被膜。毒素：内毒素，外毒素。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"b3599964-2f8c-4713-a0d9-19f63e5f9b17","retriever_from":"workflow","score":0.8600122928619385,"child_chunks":[],"segment_hit_count":10,"segment_word_count":344,"segment_position":1,"segment_index_node_hash":"8e466fd404cd840871b8bbb34b99016c3da8ace719f256148f4df77d6369195e","doc_metadata":null,"position":2},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"细菌性感染疾病是如何发生的？ / 细菌感染的定义是什么？ / 感染发生的首要条件是什么？ / 什么是细菌的外源性感染？ / 什么是细菌的内源性感染？\", \"response_chosen\": \"细菌的感染是指病原菌侵入宿主体内生长繁殖并与机体相互作用，引起的一系列病理变化过程。感染的发生首先必须有感染源（传染源）。外源性感染：患者是主要传染源，带菌者、患病或带菌动物也会引起感染。内源性感染：机体自身的体表或体内病原菌而引起的感染。这些病原菌大多是寄居在体表或体内的正常菌群，当机体免疫功能下降或其他因素，导致体内正常菌群失调而成为条件致病菌，造成感染。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"b3599964-2f8c-4713-a0d9-19f63e5f9b17","retriever_from":"workflow","score":0.9865976572036743,"child_chunks":[],"segment_hit_count":13,"segment_word_count":344,"segment_position":1,"segment_index_node_hash":"8e466fd404cd840871b8bbb34b99016c3da8ace719f256148f4df77d6369195e","doc_metadata":null,"position":1},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"细菌性感染疾病是如何发生的？ / 细菌感染的定义是什么？ / 感染发生的首要条件是什么？ / 什么是细菌的外源性感染？ / 什么是细菌的内源性感染？\", \"response_chosen\": \"细菌的感染是指病原菌侵入宿主体内生长繁殖并与机体相互作用，引起的一系列病理变化过程。感染的发生首先必须有感染源（传染源）。外源性感染：患者是主要传染源，带菌者、患病或带菌动物也会引起感染。内源性感染：机体自身的体表或体内病原菌而引起的感染。这些病原菌大多是寄居在体表或体内的正常菌群，当机体免疫功能下降或其他因素，导致体内正常菌群失调而成为条件致病菌，造成感染。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"1a6f1e0f-6720-4c0d-803b-2b6fa27c09e5","retriever_from":"workflow","score":0.9440147876739502,"child_chunks":[],"segment_hit_count":10,"segment_word_count":322,"segment_position":2,"segment_index_node_hash":"7c0453b23f8a94fb26ed303980a7eda1f486499b1bbf71ffaf8e334bc82208d1","doc_metadata":null,"position":2},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"病原菌通过哪些途径传播？ / 病原菌引起感染与哪些因素密切相关？ / 细菌感染的类型包括哪些？ / 显性感染包括哪些类型？ / 什么是带菌状态？\", \"response_chosen\": \"病原菌通过呼吸道、消化道、皮肤黏膜创伤、接触传播、以节肢动物为媒介、多途径传播。同时，病原菌是否引起感染与细菌的毒力、侵入数量以及侵入的门户密切相关。感染类型还包括显性感染、隐性感染和带菌状态。显性感染包括急性感染、慢性感染、局部感染和全身感染；带菌状态因带菌者体内带有病原菌，但无临床症状，常成为传染病流行的重要传染源。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"27582a0d-d01a-4bb3-a8f4-18cf5bee82c4","retriever_from":"workflow","score":0.713675320148468,"child_chunks":[],"segment_hit_count":4,"segment_word_count":270,"segment_position":6,"segment_index_node_hash":"ec3ae9719324d56042a67f06bc473cff9bfd7b8d8c3c7eeb036207157570f5ae","doc_metadata":null,"position":3},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第三节_细菌与病毒的致病机制及感染类型比较\", \"question\": \"细菌的致病机制是什么？ / 病原菌造成感染与哪些因素有关？ / 细菌毒力主要由哪些构成？ / 什么是细菌的侵袭力？ / 细菌毒素包括哪些？\", \"response_chosen\": \"病原菌造成感染与毒力、细菌侵入数量、细菌侵入的门户与部位有关。细菌毒力主要由侵袭力、毒素和体内其他因素（超抗原）构成。侵袭力：菌体表面结构（黏附因子菌毛、荚膜），侵袭性物质，细菌生物被膜。毒素：内毒素，外毒素。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"b3599964-2f8c-4713-a0d9-19f63e5f9b17","retriever_from":"workflow","score":0.991265594959259,"child_chunks":[],"segment_hit_count":11,"segment_word_count":344,"segment_position":1,"segment_index_node_hash":"8e466fd404cd840871b8bbb34b99016c3da8ace719f256148f4df77d6369195e","doc_metadata":null,"position":1},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"细菌性感染疾病是如何发生的？ / 细菌感染的定义是什么？ / 感染发生的首要条件是什么？ / 什么是细菌的外源性感染？ / 什么是细菌的内源性感染？\", \"response_chosen\": \"细菌的感染是指病原菌侵入宿主体内生长繁殖并与机体相互作用，引起的一系列病理变化过程。感染的发生首先必须有感染源（传染源）。外源性感染：患者是主要传染源，带菌者、患病或带菌动物也会引起感染。内源性感染：机体自身的体表或体内病原菌而引起的感染。这些病原菌大多是寄居在体表或体内的正常菌群，当机体免疫功能下降或其他因素，导致体内正常菌群失调而成为条件致病菌，造成感染。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e986e92b7da","document_name":"微生物总论部分.docx","data_source_type":"upload_file","segment_id":"1a6f1e0f-6720-4c0d-803b-2b6fa27c09e5","retriever_from":"workflow","score":0.6074702739715576,"child_chunks":[],"segment_hit_count":8,"segment_word_count":322,"segment_position":2,"segment_index_node_hash":"7c0453b23f8a94fb26ed303980a7eda1f486499b1bbf71ffaf8e334bc82208d1","doc_metadata":null,"position":2},"title":"微生物总论部分.docx","files":null,"content":"{\"where\": \"微生物总论部分.docx_第一章：微生物总论_第一节_细菌性感染疾病的发生\", \"question\": \"病原菌通过哪些途径传播？ / 病原菌引起感染与哪些因素密切相关？ / 细菌感染的类型包括哪些？ / 显性感染包括哪些类型？ / 什么是带菌状态？\", \"response_chosen\": \"病原菌通过呼吸道、消化道、皮肤黏膜创伤、接触传播、以节肢动物为媒介、多途径传播。同时，病原菌是否引起感染与细菌的毒力、侵入数量以及侵入的门户密切相关。感染类型还包括显性感染、隐性感染和带菌状态。显性感染包括急性感染、慢性感染、局部感染和全身感染；带菌状态因带菌者体内带有病原菌，但无临床症状，常成为传染病流行的重要传染源。\"}","summary":null},{"metadata":{"_source":"knowledge","dataset_id":"11178388-2535-49ca-94a2-d8fca559a44e","dataset_name":"新增医学知识检索库.txt","document_id":"bd5be99d-f249-4041-9f12-8e98