    "code": "import json\n\ndef main(body: str, filename: str) -> dict:\n    name = (filename or \"\").strip()\n    items = []\n    try:\n        data = json.loads(body or \"{}\")\n        if isinstance(data, dict) and isinstance(data.get(\"data\"), list):\n            items = data[\"data\"]\n    except Exception:\n        items = []\n    did = \"\"\n    for it in items:\n        if isinstance(it, dict) and str(it.get(\"name\") or \"\").strip() == name:\n            did = str(it.get(\"id\") or \"\")\n            break\n    return {\n        \"dataset_id\": did,\n        \"exists\": bool(did),\n        \"matched\": did[:8] if did else \"\",\n    }\n",
