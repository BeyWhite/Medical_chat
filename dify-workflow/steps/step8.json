  {
   "data": {
    "type": "code",
    "title": "解析相似问",
    "desc": "",
    "code_language": "python3",
    "code": "import json, re\ndef main(text: str) -> dict:\n    s = (text or \"\").strip()\n    m = re.search(r\"\\[.*\\]\", s, re.S)\n    if m:\n        s = m.group(0)\n    try:\n        arr = json.loads(s)\n    except Exception:\n        arr = []\n    if not isinstance(arr, list):\n        arr = []\n    qs = []\n    for x in arr:\n        if isinstance(x, str) and x.strip():\n            qs.append(x.strip())\n        elif isinstance(x, dict):\n            q = x.get(\"question\") or x.get(\"q\")\n            if q:\n                qs.append(str(q).strip())\n    seen, out = set(), []\n    for q in qs:\n        if q not in seen:\n            seen.add(q)\n            out.append(q)\n    if not out:\n        out = [s] if s else [\"医学问题\"]\n    return {\"questions\": out}\n",
    "variables": [
     {
