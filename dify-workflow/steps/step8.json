   "data": {
    "type": "code",
    "title": "取文件名/判断来源",
    "desc": "文件来自对话附件还是开始节点的文件变量",
    "code_language": "python3",
    "code": "import json\n\ndef _name_of(f):\n    if f is None:\n        return None\n    if isinstance(f, str):\n        return f or None\n    if isinstance(f, dict):\n        return f.get(\"name\") or f.get(\"filename\") or None\n    return getattr(f, \"name\", None) or getattr(f, \"filename\", None)\n\ndef _as_list(x):\n    if x is None:\n        return []\n    if isinstance(x, list):\n        return x\n    return [x]\n\ndef main(files: list, file_var) -> dict:\n    sys_files = _as_list(files)\n    var_files = _as_list(file_var)\n    if sys_files:\n        src = \"sys\"\n        name = _name_of(sys_files[0])\n    elif var_files:\n        src = \"var\"\n        name = _name_of(var_files[0])\n    else:\n        src = \"none\"\n        name = None\n    name = str(name) if name else \"医学知识文件\"\n    return {\n        \"filename\": name,\n        \"filename_esc\": json.dumps(name, ensure_ascii=False)[1:-1],\n        \"source\": src,\n        \"has_file\": src != \"none\",\n    }\n",
    "variables": [
