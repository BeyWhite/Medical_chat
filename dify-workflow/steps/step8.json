  {
   "data": {
    "type": "code",
    "title": "校验正文",
    "desc": "判断文档是否真的提取出了正文内容",
    "code_language": "python3",
    "code": "def _flatten(x):\n    if x is None:\n        return \"\"\n    if isinstance(x, str):\n        return x\n    if isinstance(x, (list, tuple)):\n        return \"\\n\".join(_flatten(i) for i in x)\n    if isinstance(x, dict):\n        return str(x.get(\"text\") or x.get(\"content\") or \"\")\n    return str(x)\n\ndef main(doc_text, var_text, merged) -> dict:\n    parts = [_flatten(doc_text), _flatten(var_text), _flatten(merged)]\n    best = max(parts, key=lambda s: len(s.strip()))\n    n = len(best.strip())\n    ok = n >= 10  # 少于 10 个字符基本就是空的 / 提取失败\n    if ok:\n        reason = \"提取正常\"\n    else:\n        reason = (\"正文为空（可能原因：扫描件/图片型 PDF 无文字层；\"\n                  \"DOCX 结构损坏导致解析失败；文档本身为空）\")\n    return {\"ok\": ok, \"reason\": reason, \"doc_chars\": n}\n",
    "variables": [
     {
      "variable": "doc_text",
      "value_selector": [
       "node_ext_sys",
       "text"
      ],
      "value_type": "array[string]"
     },
     {
      "variable": "var_text",
